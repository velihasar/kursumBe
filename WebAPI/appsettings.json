{
	"TokenOptions": {
		"Audience": "{JWT_AUDIENCE}",
		"Issuer": "{JWT_ISSUER}",
		"AccessTokenExpiration": 1000,
		"SecurityKey": "{JWT_KEY}"
	},
	"EmailConfiguration": {
		"SmtpServer": "{EMAIL_SMTP_SERVER}",
		"SmtpPort": "{EMAIL_SMTP_PORT}",
		"SenderName": "{EMAIL_SENDER_NAME}",
		"SenderEmail": "{EMAIL_SENDER_ADDR}",
		"UserName": "{EMAIL_USER}",
		"Password": "{EMAIL_PASS}"
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft": "Warning",
			"Microsoft.Hosting.Lifetime": "Information",
			"Microsoft.EntityFrameworkCore.Database.Command": "Information"
		}
	},
	"IpRateLimiting": {
		"EnableEndpointRateLimiting": true,
		"StackBlockedRequests": false,
		"RealIpHeader": "X-Real-IP",
		"ClientIdHeader": "X-ClientId",
		"HttpStatusCode": 429,
		"IpWhitelist": [],
		"EndpointWhitelist": [],
		"ClientWhitelist": [],
		"GeneralRules": [
			{
				"Endpoint": "*",
				"Period": "1m",
				"Limit": 100
			},
			{
				"Endpoint": "*:/api/auth/login",
				"Period": "1m",
				"Limit": 10
			}
		]
	},
	"IpRateLimitPolicies": {
		"IpRules": []
	},
	"AppSettings": {
		"Mode": "{APP_MODE}"
	},
	"WhiteList": [
		"::1"
	],
	"AllowedHosts": "*",
	"MessageBrokerOptions": {
		"HostName": "{BROKER_HOST}",
		"UserName": "{BROKER_USER}",
		"Password": "{BROKER_PASS}"
	},
	"CacheOptions": {
		"Host": "{CACHE_HOST}",
		"Port": "{CACHE_PORT}",
		"Password": "{CACHE_PASS}",
		"Database": 0
	},
	"TaskSchedulerOptions": {
		"Enabled": true,
		"StorageType": "inMemory",
		"ConnectionString": "",
		"RecurringJobsJsonFilePath": "RecurringJobs.json",
		"Title": "okulBe Scheduled Jobs",
		"Path": "/jobs",
		"Username": "{HANGFIRE_USER}",
		"Password": "{HANGFIRE_PASS}"
	},
	"ElasticSearchConfig": {
		"ConnectionString": "{ELASTIC_URL}",
		"UserName": "{ELASTIC_USER}",
		"Password": "{ELASTIC_PASS}"
	},
	"MongoDbSettings": {
		"ConnectionString": "{MONGODB_CONN}",
		"DatabaseName": "{MONGODB_DB}"
	},
	"SeriLogConfigurations": {
		"PostgreConfiguration": {
			"ConnectionString": "{DARCH_PG_CONN}"
		},
		"MsSqlConfiguration": {
			"ConnectionString": "{DARCH_MS_CONN}"
		},
		"OracleConfiguration": {
			"ConnectionString": "{DARCH_ORACLE_CONN}"
		},
		"FileLogConfiguration": {
			"FolderPath": "/logs/"
		},
		"MSTeamsConfiguration": {
			"ChannelHookAdress": ""
		},
		"MongoDbConfiguration": {
			"ConnectionString": "{MONGODB_CONN}",
			"Collection": "logs"
		}
	},
	"MinioSettings": {
		"Endpoint": "127.0.0.1:9000",
		"AccessKey": "minioadmin",
		"SecretKey": "minioadmin",
		"BucketName": "okul",
		"UseSSL": false
	}
}